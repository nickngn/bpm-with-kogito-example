  "identityProviders": [
    {
      "alias": "adfs",
      "displayName": "Corporate ADFS",
      "providerId": "saml",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "config": {
        "REPLACE_ME": "Placeholder federation only - disabled until real ADFS values are filled in below, then flip enabled to true. Values come from your ADFS server's federation metadata, typically at https://<adfs-host>/federationmetadata/2007-06/federationmetadata.xml",
        "singleSignOnServiceUrl": "https://adfs.example.com/adfs/ls/",
        "singleLogoutServiceUrl": "https://adfs.example.com/adfs/ls/",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified",
        "entityId": "http://localhost:8081/realms/kogito",
        "signingCertificate": "REPLACE_WITH_ADFS_TOKEN_SIGNING_CERTIFICATE_BASE64",
        "wantAuthnRequestsSigned": "false",
        "validateSignature": "true",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true"
      }
    }
  ]
