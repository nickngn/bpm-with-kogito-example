  "clients": [
    {
      "clientId": "kogito-console-react",
      "name": "Task Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8380/*"
      ],
      "webOrigins": [
        "http://localhost:8380"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "management-console-dev-webapp",
      "name": "Management Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8280/*"
      ],
      "webOrigins": [
        "http://localhost:8280"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "account-opening-ui",
      "name": "Account Opening UI",
      "enabled": true,
      "publicClient": false,
      "secret": "account-opening-ui-secret",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8090/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8090/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
