<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.3</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>com.example</groupId>
  <artifactId>kogito-springboot-app</artifactId>
  <version>1.0-SNAPSHOT</version>

  <description>Generated project kogito-springboot-app</description>

  <properties>
    <java.version>17</java.version>
    <kogito.version>10.2.0</kogito.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.kie.kogito</groupId>
        <artifactId>kogito-spring-boot-bom</artifactId>
        <version>${kogito.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
       <groupId>org.jbpm</groupId>
       <artifactId>jbpm-with-drools-spring-boot-starter</artifactId>
    </dependency>


    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Publishes the OpenAPI doc for the generated REST resources (AccountOpeningResource,
         UserTasksResource) at /v3/api-docs and a browsable UI at /swagger-ui.html.
         account-opening-ui's REST client is generated from a spec captured from this.
         Despite the webflux starter dependency above, jbpm-with-drools-spring-boot-starter
         pulls in spring-boot-starter-web too, so Spring Boot actually runs this app on the
         Servlet (Tomcat) stack - hence webmvc here, not webflux. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.5</version>
    </dependency>

    <!-- Embedded Data Index: serves /graphql, which both consoles query to list
         process/task instances. Backed by H2 below; no Kafka or extra service needed. -->
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kogito-addons-springboot-data-index-jpa</artifactId>
      <version>${kogito.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-addons-springboot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Management Console needs these to abort/retrigger process instances and
         reassign/manage tasks; Task Console needs the task-management one too. -->
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-addons-springboot-process-management</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jbpm</groupId>
      <artifactId>jbpm-addons-springboot-task-management</artifactId>
    </dependency>

    <!-- Process diagram (with current node highlighted) in Management Console. -->
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-addons-springboot-process-svg</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.kie.kogito</groupId>
        <artifactId>kogito-maven-plugin</artifactId>
        <version>${kogito.version}</version>
        <executions>
          <execution>
            <phase>compile</phase>
            <goals>
              <goal>generateModel</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
