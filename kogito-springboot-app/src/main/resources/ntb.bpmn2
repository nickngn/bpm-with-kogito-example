<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:itemDefinition id="_stringItem" structureRef="String" />
  <bpmn:itemDefinition id="_booleanItem" structureRef="Boolean" />

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Account Opening Process" processRef="accountOpening" />
  </bpmn:collaboration>

  <bpmn:process id="accountOpening" name="Account Opening Process" drools:packageName="com.example" drools:version="1.0" isExecutable="true" processType="Public">

    <!-- Process variables. Drive every gateway; all are optional on start. -->
    <bpmn:property id="applicantName" name="applicantName" itemSubjectRef="_stringItem" />
    <bpmn:property id="cif" name="cif" itemSubjectRef="_stringItem" />
    <bpmn:property id="robChecksPass" name="robChecksPass" itemSubjectRef="_booleanItem" />
    <bpmn:property id="preCheckPass" name="preCheckPass" itemSubjectRef="_booleanItem" />
    <bpmn:property id="cddDecision" name="cddDecision" itemSubjectRef="_stringItem" />
    <bpmn:property id="kycDecision" name="kycDecision" itemSubjectRef="_stringItem" />
    <bpmn:property id="clientUpgrade" name="clientUpgrade" itemSubjectRef="_booleanItem" />
    <bpmn:property id="furtherUpgrade" name="furtherUpgrade" itemSubjectRef="_booleanItem" />
    <bpmn:property id="aoSuccessful" name="aoSuccessful" itemSubjectRef="_booleanItem" />

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Data collection and filling">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_60days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Documents and KYC review / approval">
        <bpmn:flowNodeRef>Gateway_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CDD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6d</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Account opening and notification">
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_1" name="Fill static data in ROB">
      <bpmn:documentation>1. FOSS fills in static data in ROB [FO/FOSS/KYC]</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_1_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_1_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:dataOutput id="Task_1_applicantNameOut" name="applicantName" itemSubjectRef="_stringItem" />
        <bpmn:dataOutput id="Task_1_robChecksPassOut" name="robChecksPass" itemSubjectRef="_booleanItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_1_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_1_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Task_1_applicantNameOut</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>Task_1_robChecksPassOut</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_1_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">Fill static data in ROB</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_1_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_1_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">FOSS</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_1_GroupIdIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation>
        <bpmn:sourceRef>Task_1_applicantNameOut</bpmn:sourceRef>
        <bpmn:targetRef>applicantName</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation>
        <bpmn:sourceRef>Task_1_robChecksPassOut</bpmn:sourceRef>
        <bpmn:targetRef>robChecksPass</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Event_60days" name="60 days" attachedToRef="Task_1" cancelActivity="true">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P60D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_8" name="Expired">
      <bpmn:documentation>8. Expired [FOSS]</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_8_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_8_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_8_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_8_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_8_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">Expired</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_8_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_8_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">FOSS</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_8_GroupIdIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_1" name="ROB checks pass?" gatewayDirection="Diverging" default="Flow_4">
      <bpmn:documentation>REVIEW: the "No" branch currently skips the Control Tower pre-check and goes straight to Task_3 (Reserve a CIF). Confirm whether this gateway is a pass/fail check or a "pre-check required?" routing decision.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_2" name="Control Tower pre check">
      <bpmn:documentation>2. Control Tower pre-check [KYC]</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_2_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_2_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:dataOutput id="Task_2_preCheckPassOut" name="preCheckPass" itemSubjectRef="_booleanItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_2_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_2_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Task_2_preCheckPassOut</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_2_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">Control Tower pre check</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_2_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_2_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">KYC</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_2_GroupIdIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation>
        <bpmn:sourceRef>Task_2_preCheckPassOut</bpmn:sourceRef>
        <bpmn:targetRef>preCheckPass</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_2" name="Pre-check pass?" gatewayDirection="Diverging" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_3" name="Reserve a CIF">
      <bpmn:documentation>3. Reserve a CIF</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_3_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_3_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:dataOutput id="Task_3_cifOut" name="cif" itemSubjectRef="_stringItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_3_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_3_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Task_3_cifOut</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_3_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">Reserve a CIF</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_3_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_3_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">FOSS</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_3_GroupIdIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation>
        <bpmn:sourceRef>Task_3_cifOut</bpmn:sourceRef>
        <bpmn:targetRef>cif</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_4" name="Submit to CDD">
      <bpmn:documentation>4. FOSS submits to CDD [FOSS]</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_4_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_4_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_4_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_4_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_4_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">Submit to CDD</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_4_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_4_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">FOSS</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_4_GroupIdIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>

    <bpmn:inclusiveGateway id="Gateway_Fork" name="Start KYC and CDD review" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:userTask id="Task_7" name="KYC review in OKP">
      <bpmn:documentation>7. KYC review in OKP [KYC]</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_7_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_7_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:dataOutput id="Task_7_kycDecisionOut" name="kycDecision" itemSubjectRef="_stringItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_7_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_7_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Task_7_kycDecisionOut</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_7_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">KYC review in OKP</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_7_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_7_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">KYC</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_7_GroupIdIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation>
        <bpmn:sourceRef>Task_7_kycDecisionOut</bpmn:sourceRef>
        <bpmn:targetRef>kycDecision</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_3" name="KYC decision?" gatewayDirection="Diverging" default="Flow_18">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_5" name="CDD review">
      <bpmn:documentation>5. CDD review [CDD]</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_5_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_5_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:dataOutput id="Task_5_cddDecisionOut" name="cddDecision" itemSubjectRef="_stringItem" />
        <bpmn:dataOutput id="Task_5_clientUpgradeOut" name="clientUpgrade" itemSubjectRef="_booleanItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_5_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_5_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Task_5_cddDecisionOut</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>Task_5_clientUpgradeOut</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_5_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">CDD review</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_5_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_5_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">CDD</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_5_GroupIdIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation>
        <bpmn:sourceRef>Task_5_cddDecisionOut</bpmn:sourceRef>
        <bpmn:targetRef>cddDecision</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation>
        <bpmn:sourceRef>Task_5_clientUpgradeOut</bpmn:sourceRef>
        <bpmn:targetRef>clientUpgrade</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CDD" name="CDD decision?" gatewayDirection="Diverging" default="Flow_20">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_4" name="Client upgrade in screening?" gatewayDirection="Diverging" default="Flow_22">
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_6a" name="Inform BSA of upgrade">
      <bpmn:documentation>6a. Inform BSA of upgrade; BSA awaits KYC approval [BSA]</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="Task_6a_TaskNameIn" name="TaskName" itemSubjectRef="_stringItem" />
        <bpmn:dataInput id="Task_6a_GroupIdIn" name="GroupId" itemSubjectRef="_stringItem" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Task_6a_TaskNameIn</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_6a_GroupIdIn</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_6a_TaskNameIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">Inform BSA of upgrade</bpmn:from>
          <bpmn:to xsi:type="bpmn:tFormalExpression">Task_6a_TaskNameIn</bpmn:to>
        </bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation>
        <bpmn:targetRef>Task_6a_GroupIdIn</bpmn:targetRef>
        <bpmn:assignment>
          <bpmn:from xsi:type="bpmn:tFormalExpression">BSA</bpmn:from>
