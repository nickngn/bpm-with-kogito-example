    <bpmn:inclusiveGateway id="Gateway_Join" name="KYC and CDD complete" gatewayDirection="Converging">
      <bpmn:documentation>Inclusive (OR) join: fires once no other incoming branch can still deliver a token. This is what unblocks the "KYC Rejected" / "Return to CDD" / "no upgrade" paths that would deadlock a parallel join.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
