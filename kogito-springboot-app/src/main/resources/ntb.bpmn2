    <bpmn:sequenceFlow id="Flow_1" name="New → Prospect" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="Gateway_1" targetRef="Task_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return robChecksPass != null &amp;&amp; robChecksPass;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="Gateway_1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_2" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="Gateway_2" targetRef="Task_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return preCheckPass != null &amp;&amp; preCheckPass;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="No → KYC Rejected" sourceRef="Gateway_2" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Event_60days" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_10" name="Reactivate → Prospect" sourceRef="Task_8" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_12" name="Pending AO" sourceRef="Task_4" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Fork" targetRef="Task_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return true;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Fork" targetRef="Task_5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return true;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_7" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="Flow_16" name="KYC Approved" sourceRef="Gateway_3" targetRef="Gateway_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return "YES".equals(kycDecision);</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" name="KYC Rejected" sourceRef="Gateway_3" targetRef="Task_16">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return "NO".equals(kycDecision);</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="Return to CDD" sourceRef="Gateway_3" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_5" targetRef="Gateway_CDD" />
    <bpmn:sequenceFlow id="Flow_20" name="NOK → Return to FOSS" sourceRef="Gateway_CDD" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_37" name="OK → Submitted to KYC" sourceRef="Gateway_CDD" targetRef="Gateway_4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return "YES".equals(cddDecision);</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" name="Yes" sourceRef="Gateway_4" targetRef="Task_6a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return clientUpgrade != null &amp;&amp; clientUpgrade;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" name="No" sourceRef="Gateway_4" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_6a" targetRef="Task_6b" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_6b" targetRef="Task_6c" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_6c" targetRef="Task_6d" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_6d" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_Join" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_10" targetRef="Gateway_6" />
    <bpmn:sequenceFlow id="Flow_31" name="Yes → AO Completed" sourceRef="Gateway_6" targetRef="Task_11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return aoSuccessful != null &amp;&amp; aoSuccessful;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_32" name="No → AO Failed" sourceRef="Gateway_6" targetRef="Task_10b" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_10b" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_11" targetRef="Task_13" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_13" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_16" targetRef="EndEvent_2" />

    </bpmn:process>

